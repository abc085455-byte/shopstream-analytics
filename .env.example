# ============================================================
# ShopStream Analytics — Environment Configuration
# COPY this file to .env and fill in your actual values
# NEVER commit .env to git
# ============================================================

# ─── AWS S3 ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1
AWS_S3_BUCKET=shopstream-raw-data
AWS_S3_PREFIX=ecommerce/

# S3 Folder Structure:
# s3://shopstream-raw-data/ecommerce/orders/YYYY/MM/DD/
# s3://shopstream-raw-data/ecommerce/customers/YYYY/MM/DD/
# s3://shopstream-raw-data/ecommerce/products/YYYY/MM/DD/
# s3://shopstream-raw-data/ecommerce/events/YYYY/MM/DD/

# ─── SNOWFLAKE ──────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=your_account.region
SNOWFLAKE_USER=shopstream_user
SNOWFLAKE_PASSWORD=your_password_here
SNOWFLAKE_DATABASE=SHOPSTREAM_DB
SNOWFLAKE_WAREHOUSE=SHOPSTREAM_WH
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_SCHEMA=RAW

# ─── DATABRICKS ─────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your_token_here
DATABRICKS_CLUSTER_ID=your_cluster_id
DATABRICKS_JOBS_API_VERSION=2.1

# ─── AIRFLOW ────────────────────────────────────────────────
AIRFLOW_HOME=D:\airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=your_fernet_key
AIRFLOW__WEBSERVER__SECRET_KEY=your_secret_key

# ─── DBT ────────────────────────────────────────────────────
DBT_PROFILES_DIR=./config
DBT_PROJECT_DIR=./dbt
DBT_TARGET=dev

# ─── NOTIFICATIONS (Optional) ───────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK
ALERT_EMAIL=your-email@company.com
